# Локальное окружение. Не вставляйте реальные секреты в Git.
PORT=4317
APP_URL=http://localhost:4317
NODE_ENV=development
# SQLite используется только для локальной проверки без DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Минимум 32 случайных символа для production
SESSION_SECRET=
# Для согласованного внешнего размещения:
# CONTENT_PUBLICATION_APPROVED=yes
# CONFIRM_DEPLOY_DATABASE=yes
